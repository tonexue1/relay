# DeepSeek（OpenAI 兼容）。换别家只改这两行。
NOVELIST_API_KEY=sk-xxx
NOVELIST_BASE_URL=https://api.deepseek.com

# DeepSeek V4。旧的 deepseek-chat / deepseek-reasoner 已于 2026-07-24 下线。
# flash 便宜够用；pro 留给需要更强判断和文笔的环节。
NOVELIST_MODEL_DEFAULT=deepseek-v4-flash
NOVELIST_MODEL_PLANNER=deepseek-v4-pro
NOVELIST_MODEL_NARRATOR=deepseek-v4-pro
NOVELIST_MODEL_DIRECTOR=deepseek-v4-flash
NOVELIST_MODEL_ACTOR=deepseek-v4-flash
NOVELIST_MODEL_CRITIC=deepseek-v4-flash
NOVELIST_MODEL_CHRONICLER=deepseek-v4-flash
# 审校要挑出成文后的硬伤，判断力要求高，值得上 pro。
NOVELIST_MODEL_REVIEWER=deepseek-v4-pro
# 起标题是小活，最便宜的就够。
NOVELIST_MODEL_TITLER=deepseek-v4-flash

# JSON 模式下 token 要给足：思考 token 也算输出，给少了会截断成坏 JSON。
NOVELIST_MAX_TOKENS=8192

# 按角色单独给预算，覆盖上面那行。审校要先写审查清单再吐硬伤 JSON，
# 篇幅是别人的几倍；给统一预算会写到一半被截断，JSON 永远出不来，
# 然后被"审不出、按通过兜底"静默放过——看上去像审校很宽松，其实是没审。
NOVELIST_MAX_TOKENS_REVIEWER=16384

# 叙述者一章一次落笔，输出比场级长一个量级。8192 在思考型模型上会被推理吃光、
# 正文一个字不吐——真跑上撞过：finish_reason=length 且 content 为空，连试三次
# 后整章报错。空产出会重试而不是静默接受，所以这类事故是响的，不是哑的。
NOVELIST_MAX_TOKENS_NARRATOR=16384

# 关掉思考模式的角色。这些角色做的是结构化抽取和判定，开思考只是变慢变贵。
# 审校也该关：它的 prompt 已经要求把审查过程写成正文，那就是它的推理；
# 再开原生思考等于同一件事付两遍钱，还跟正文抢同一个输出预算。
# 留空则不发 thinking 参数，用服务端默认。
NOVELIST_THINKING_DISABLED_ROLES=ACTOR,CRITIC,CHRONICLER,DIRECTOR,REVIEWER,TITLER
