# Constrained triple list for on-device dream extract.
# Copy this file into JNI (S0) — do not let the 3B free-write JSON.
root ::= ws object

object ::= "{" ws "\"triples\"" ws ":" ws array ws "}" ws

array ::= "[" ws "]" | "[" ws triple (ws "," ws triple){0,7} ws "]"

triple ::= "{" ws "\"s\"" ws ":" ws string ws "," ws "\"p\"" ws ":" ws pred ws "," ws "\"o\"" ws ":" ws string ws "}"

pred ::= "\"" pred-name "\""

pred-name ::= "allergic_to" | "likes" | "dislikes" | "prefers" | "diet" | "lives_in" | "work_location" | "born_in" | "works_at" | "works_as" | "alumni_of" | "member_of" | "skilled_in" | "knows_language" | "colleague_of" | "friend_of" | "family_of" | "spouse_of" | "parent_of" | "child_of" | "sibling_of" | "has_pet" | "named" | "owns" | "takes" | "attends" | "plans" | "has_task" | "work_years" | "located_in"

string ::= "\"" chars "\""

chars ::= char+

char ::= [^"\\] | "\\" ["\\/bfnrt]

ws ::= ([ \t\n\r] ws)?
